# ============================================================
# Payment Exception Resolution Agent - Environment Variables
# ============================================================

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
TEMPERATURE=0.3

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=payment_exception_db
DB_USER=root
DB_PASSWORD=your-mysql-password-here

# Application Settings
LOG_LEVEL=INFO
LOG_FILE=logs/payment_exception.log

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Payment Exception Settings
EXCEPTION_ID_PREFIX=EXC
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=60
LATENCY_BUDGET_MS=5000

# Compliance thresholds
AML_AMOUNT_THRESHOLD=10000
HIGH_VALUE_THRESHOLD=50000
DUPLICATE_WINDOW_SECONDS=300

# Rail cut-off times (24h format, UTC)
NEFT_CUTOFF=18:30
RTGS_CUTOFF=17:00
IMPS_CUTOFF=23:59
SWIFT_CUTOFF=15:00
